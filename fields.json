{
  "fontSize": {
    "type": "slider",
    "label": "Text size (px)",
    "value": 14,
    "min": 10,
    "max": 28,
    "step": 1
  },
  "chatWidth": {
    "type": "slider",
    "label": "Chat width (%)",
    "value": 100,
    "min": 30,
    "max": 100,
    "step": 5
  },
  "alignment": {
    "type": "dropdown",
    "label": "Message alignment",
    "value": "left",
    "options": {
      "left":   "Left",
      "right":  "Right",
      "center": "Center"
    }
  },
  "perspectiveX": {
    "type": "slider",
