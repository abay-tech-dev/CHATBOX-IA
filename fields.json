  "perspectiveY": {
    "type": "slider",
    "label": "3D Rotation — Y Axis (left/right)",
    "value": 0,
    "min": -45,
    "max": 45,
    "step": 1
  },
  "theme": {
    "type": "dropdown",
    "label": "Theme",
    "value": "amoled",
    "options": {
      "dark":   "Dark (Gamer)",
      "light":  "Light",
      "amoled": "AMOLED (Pure Black)"
    }
  },
  "accentColor": {
    "type": "colorpicker",
    "label": "Accent color",
