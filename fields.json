{
  "fontSize": {
    "type": "slider",
    "label": "Taille du texte (px)",
    "value": 14,
    "min": 10,
    "max": 28,
    "step": 1
  },
  "chatWidth": {
    "type": "slider",
    "label": "Largeur du chat (%)",
    "value": 100,
    "min": 30,
    "max": 100,
    "step": 5
  },
  "alignment": {
    "type": "dropdown",
    "label": "Alignement des messages",
    "value": "left",
    "options": {
      "left":   "Gauche",
      "right":  "Droite",
      "center": "Centre"
    }
  },
  "perspectiveX": {
    "type": "slider",
    "label": "Rotation 3D — Axe X (haut/bas)",
    "value": 0,
    "min": -45,
    "max": 45,
    "step": 1
  },
  "perspectiveY": {
    "type": "slider",
    "label": "Rotation 3D — Axe Y (gauche/droite)",
    "value": 0,
    "min": -45,
    "max": 45,
    "step": 1
  },
  "theme": {
    "type": "dropdown",
    "label": "Thème",
    "value": "dark",
    "options": {
      "dark":   "Sombre (Gamer)",
      "light":  "Clair",
      "amoled": "AMOLED (Noir pur)"
    }
  },
  "accentColor": {
    "type": "colorpicker",
    "label": "Couleur d'accent",
    "value": "#00c8ff"
  },
  "backgroundOpacity": {
    "type": "slider",
    "label": "Opacité du fond (%)",
    "value": 88,
    "min": 0,
    "max": 100,
    "step": 5
  },
  "showBadges": {
    "type": "checkbox",
    "label": "Afficher les badges de rôle",
    "value": true
  },
  "showAvatars": {
    "type": "checkbox",
    "label": "Afficher les avatars",
    "value": true
  },
  "maxMessages": {
    "type": "slider",
    "label": "Nombre maximum de messages",
    "value": 12,
    "min": 3,
    "max": 25,
    "step": 1
  },
  "messageAnimation": {
    "type": "dropdown",
    "label": "Animation d'entrée",
    "value": "spring",
    "options": {
      "spring": "Ressort (dynamique)",
      "slide":  "Glissement",
      "fade":   "Fondu",
      "none":   "Aucune"
    }
  },
  "showAlerts": {
    "type": "checkbox",
    "label": "Afficher les alertes",
    "value": true
  },
  "alertDuration": {
    "type": "slider",
    "label": "Durée des alertes (secondes)",
    "value": 5,
    "min": 2,
    "max": 15,
    "step": 1
  },
  "modColor": {
    "type": "colorpicker",
    "label": "Couleur Modérateur",
    "value": "#00ff88"
  },
  "vipColor": {
    "type": "colorpicker",
    "label": "Couleur VIP",
    "value": "#a855f7"
  },
  "subColor": {
    "type": "colorpicker",
    "label": "Couleur Abonné",
    "value": "#ffc200"
  },
  "showGoal": {
    "type": "checkbox",
    "label": "── BARRE DE GOAL ── Afficher la barre de goal",
    "value": false
  },
  "goalType": {
    "type": "dropdown",
    "label": "Goal — Type d'objectif",
    "value": "followers",
    "options": {
      "followers":  "Followers",
      "subs":       "Abonnés",
      "bits":       "Bits",
      "donations":  "Dons (€)"
    }
  },
  "goalTitle": {
    "type": "text",
    "label": "Goal — Titre affiché",
    "value": "Objectif du stream"
  },
  "goalCurrent": {
    "type": "slider",
    "label": "Goal — Valeur de départ",
    "value": 0,
    "min": 0,
    "max": 10000,
    "step": 1
  },
  "goalTarget": {
    "type": "slider",
    "label": "Goal — Valeur cible",
    "value": 100,
    "min": 1,
    "max": 10000,
    "step": 1
  },
  "goalOrientation": {
    "type": "dropdown",
    "label": "Goal — Orientation de la barre",
    "value": "horizontal",
    "options": {
      "horizontal": "Horizontale (bas de l'écran)",
      "vertical":   "Verticale (côté droit)"
    }
  },
  "goalColor": {
    "type": "colorpicker",
    "label": "Goal — Couleur de la barre",
    "value": "#00c8ff"
  },
  "goalAutoTrack": {
    "type": "checkbox",
    "label": "Goal — Auto-compter les événements du stream",
    "value": true
  }
}
